<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="io.matv.Calculator" path="/io/matv/Calculator/">
    <key name="window-width" type="i">
      <default>380</default>
      <summary>Main window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>780</default>
      <summary>Main window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Whether the main window is maximized</summary>
    </key>
    <key name="angle-mode" type="s">
      <choices>
        <choice value="rad"/>
        <choice value="deg"/>
      </choices>
      <default>"rad"</default>
      <summary>Angle mode for trigonometric functions (radians or degrees)</summary>
    </key>
    <key name="inverse-mode" type="b">
      <default>false</default>
      <summary>Whether scientific inverse (2nd-function) mode is active</summary>
    </key>
    <key name="converter-category" type="s">
      <default>"length"</default>
      <summary>Last-used unit-converter category (lowercase category name)</summary>
    </key>
    <key name="number-format" type="s">
      <choices>
        <choice value="en-us"/>
        <choice value="es-ar"/>
      </choices>
      <default>"en-us"</default>
      <summary>Number format locale for display grouping and decimal separators</summary>
    </key>
    <key name="active-mode" type="s">
      <choices>
        <choice value="calculator"/>
        <choice value="converter"/>
        <choice value="programmer"/>
        <choice value="financial"/>
      </choices>
      <default>"calculator"</default>
      <summary>The active top-level mode (calculator or converter)</summary>
    </key>
    <key name="prog-base" type="s">
      <choices>
        <choice value="hex"/>
        <choice value="dec"/>
        <choice value="oct"/>
        <choice value="bin"/>
      </choices>
      <default>"dec"</default>
      <summary>Programmer-mode numeric base</summary>
    </key>
    <key name="prog-bit-width" type="i">
      <default>32</default>
      <summary>Programmer-mode bit width (8, 16, 32 or 64)</summary>
    </key>
    <key name="prog-signed" type="b">
      <default>true</default>
      <summary>Whether programmer mode interprets values as signed</summary>
    </key>
    <key name="fin-calc" type="s">
      <choices>
        <choice value="compound"/>
        <choice value="loan"/>
        <choice value="simple"/>
        <choice value="margin"/>
        <choice value="depreciation"/>
      </choices>
      <default>"compound"</default>
      <summary>Last-used financial calculator</summary>
    </key>
    <key name="last-calc-mode" type="s">
      <choices>
        <choice value="calculator"/>
        <choice value="programmer"/>
      </choices>
      <default>"calculator"</default>
      <summary>The calculator-family mode to return to when leaving the converter</summary>
    </key>
  </schema>
</schemalist>
